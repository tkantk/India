{
  "name": "namaste-india",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "node scripts/validate-content.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:hit": "node scripts/build-hitlayer.mjs",
    "probe:map": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/probe-map-hits.mjs",
    "probe:camera": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/probe-camera.mjs",
    "colour:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/colour-check.mjs",
    "tts:draft": "node scripts/tts.mjs --provider=say",
    "tts:final": "node --env-file-if-exists=.env scripts/tts.mjs --provider=elevenlabs",
    "voices": "node --env-file-if-exists=.env scripts/voices.mjs",
    "fetch:photos": "node scripts/fetch-photos.mjs",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "fetch:sounds": "node scripts/fetch-sounds.mjs",
    "build:art": "node scripts/build-geo-art.mjs",
    "contact-sheet:art": "node scripts/contact-sheet-art.mjs",
    "contact-sheet:mor": "node scripts/contact-sheet-mor.mjs",
    "tour:strip": "node scripts/tour-strip.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mapbox/geojson-rewind": "^0.5.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.1",
    "mapshaper": "^0.7.54",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
