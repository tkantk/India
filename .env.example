# Copy this file to .env and fill in the values below. .env is gitignored
# and is loaded automatically by the npm scripts that need it (tts:final,
# voices, sound:candidates) via Node's `--env-file-if-exists=.env` flag — if you run one of
# those scripts' files directly with plain `node` instead of `npm run`,
# pass that same flag yourself or the variables below will not be set.

# Get a key at https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=
# Discover and add a voice: npm run voices
ELEVENLABS_VOICE_ID=

# Sound sourcing (npm run sound:candidates). Never needed to build or run
# the app; only to search for new recordings.
# A free account's API token: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=
# A free account's API key: https://xeno-canto.org/account
XENO_CANTO_API_KEY=
